# ==============================================================================
# PostgreSQL with Python: Analytics, ORM, and Database Applications
# Module 1 — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the repository root:
#      cp .env.example .env
# 2. Do NOT commit `.env` to version control.
# 3. Treat `.env` as a local developer convenience file, not encrypted storage.
# ==============================================================================

# ------------------------------------------------------------------------------
# Container Bootstrap Settings (used by `compose.yaml` on initial volume creation)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lab_bootstrap_superuser_pw
POSTGRES_DB=goliath_ecommerce
PG_HOST_PORT=54329

# ------------------------------------------------------------------------------
# Client Connection Endpoint (used by Python / Psycopg / DuckDB / SQLAlchemy)
# Note: 127.0.0.1 refers to the host machine when Python runs on the host.
# ------------------------------------------------------------------------------
PGHOST=127.0.0.1
PGPORT=54329
PGDATABASE=goliath_ecommerce
PGCONNECT_TIMEOUT=5

# ------------------------------------------------------------------------------
# Role-Separated Database Identities (configured by `bootstrap/01_roles_and_database.sql`)
# Note: `course_owner` is a NOLOGIN role that owns schemas and tables.
# Neither `course_app` nor `course_analyst` is a superuser or object owner.
# ------------------------------------------------------------------------------

# 1. Controlled Migration Identity (can `SET ROLE course_owner` for DDL)
COURSE_MIGRATOR_USER=course_migrator
COURSE_MIGRATOR_PASSWORD=lab_migrator_pw_change_me

# 2. Application Read/Write Identity (used by Psycopg / SQLAlchemy services)
COURSE_APP_USER=course_app
COURSE_APP_PASSWORD=lab_app_pw_change_me

# 3. Analytical Read-Only Identity (used by DuckDB 2.0 analytical sessions)
COURSE_ANALYST_USER=course_analyst
COURSE_ANALYST_PASSWORD=lab_analyst_pw_change_me
